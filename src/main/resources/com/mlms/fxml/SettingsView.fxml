<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mlms.controller.SettingsController"
            styleClass="main-content">

    <top>
        <VBox spacing="10">
            <padding>
                <Insets top="20" bottom="20" left="20" right="20"/>
            </padding>
            <Label text="Settings" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
            <Label text="Manage your application settings and security." style="-fx-text-fill: #5a6b7c;"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="20" maxWidth="500" alignment="TOP_LEFT">
            <padding>
                <Insets top="20" bottom="20" left="20" right="20"/>
            </padding>
            
            <VBox style="-fx-background-color: #ffffff; -fx-background-radius: 10px; -fx-padding: 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);" spacing="15">
                <Label text="Change Password" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #166c9c;"/>
                
                <VBox spacing="5">
                    <Label text="Current Password"/>
                    <PasswordField fx:id="txtCurrentPassword" promptText="Enter current password" styleClass="text-field"/>
                </VBox>
                
                <VBox spacing="5">
                    <Label text="New Password"/>
                    <PasswordField fx:id="txtNewPassword" promptText="Enter new password" styleClass="text-field"/>
                    <Label text="Must be 8-16 chars long, with at least 1 symbol and 1 number." style="-fx-text-fill: #7f8c8d; -fx-font-size: 11px;"/>
                </VBox>
                
                <VBox spacing="5">
                    <Label text="Confirm New Password"/>
                    <PasswordField fx:id="txtConfirmPassword" promptText="Confirm new password" styleClass="text-field"/>
                </VBox>
                
                <Label fx:id="lblMessage" wrapText="true" visible="false"/>
                
                <Button text="Update Password" onAction="#handleUpdatePassword" styleClass="btn-primary"/>
            </VBox>
        </VBox>
    </center>

</BorderPane>
