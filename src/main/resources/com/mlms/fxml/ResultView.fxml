<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.cell.PropertyValueFactory?>

<VBox spacing="20" styleClass="main-content" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.mlms.controller.ResultController">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
    
    <Label text="Results" styleClass="page-title"/>
    
    <HBox spacing="10">
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Add Result" onAction="#addResult" styleClass="btn-primary"/>
        <Button text="Edit Selected" onAction="#editResult" styleClass="btn-secondary"/>
        <Button text="Delete" onAction="#deleteResult" styleClass="btn-secondary"/>
    </HBox>
    
    <TableView fx:id="resultTable" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn text="ID" prefWidth="50" visible="false"><cellValueFactory><PropertyValueFactory property="id"/></cellValueFactory></TableColumn>
            <TableColumn text="Result Number" prefWidth="120"><cellValueFactory><PropertyValueFactory property="resultNumber"/></cellValueFactory></TableColumn>
            <TableColumn fx:id="patientColumn" text="Patient ID" prefWidth="100"/>
            <TableColumn text="Test Number" prefWidth="120"><cellValueFactory><PropertyValueFactory property="testNumber"/></cellValueFactory></TableColumn>
            <TableColumn text="Test Result" prefWidth="250"><cellValueFactory><PropertyValueFactory property="testResult"/></cellValueFactory></TableColumn>
            <TableColumn text="Date" prefWidth="120"><cellValueFactory><PropertyValueFactory property="resultDate"/></cellValueFactory></TableColumn>
            <TableColumn text="Cost" prefWidth="100"><cellValueFactory><PropertyValueFactory property="testCost"/></cellValueFactory></TableColumn>
        </columns>
    </TableView>
</VBox>
