<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.cell.PropertyValueFactory?>

<VBox spacing="20" styleClass="main-content" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.mlms.controller.LabTestController">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
    
    <Label text="Lab Tests" styleClass="page-title"/>
    
    <HBox spacing="10">
        <TextField fx:id="searchField" promptText="Search Lab Tests..." prefWidth="250"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Add Lab Test" onAction="#addTest" styleClass="btn-primary"/>
        <Button text="Edit Selected" onAction="#editTest" styleClass="btn-secondary"/>
        <Button text="Delete" onAction="#deleteTest" styleClass="btn-secondary"/>
    </HBox>
    
    <TableView fx:id="testTable" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn text="ID" prefWidth="50" visible="false"><cellValueFactory><PropertyValueFactory property="id"/></cellValueFactory></TableColumn>
            <TableColumn text="Test Number" prefWidth="150"><cellValueFactory><PropertyValueFactory property="testNumber"/></cellValueFactory></TableColumn>
            <TableColumn text="Test Name" prefWidth="300"><cellValueFactory><PropertyValueFactory property="testName"/></cellValueFactory></TableColumn>
            <TableColumn text="Test Cost (UGX)" prefWidth="150"><cellValueFactory><PropertyValueFactory property="testCost"/></cellValueFactory></TableColumn>
        </columns>
    </TableView>
</VBox>
